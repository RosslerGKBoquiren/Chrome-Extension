{
  "manifest_version": 3,
  "name": "Leads Tracker",
  "version": "1.0.0",
  "description": "A professional tool to track and save leads to a Firebase database.",
  "icons": {
    "16": "favicon-16x16.png",
    "32": "favicon-32x32.png",
    "128": "apple-touch-icon.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "favicon-32x32.png"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "https://*.firebaseio.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' http://localhost:5173; object-src 'self'"
  }
}